{
  "name": "dsh-usage-stats",
  "version": "0.2.0",
  "type": "module",
  "description": "Usage statistics in Settings: token totals, activity heatmap, daily trend by model, and model share.",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "usage-statistics",
    "token-usage"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test:host && npm run test:client",
    "test:host": "node test/host.test.mjs",
    "test:client": "node test/client.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}
